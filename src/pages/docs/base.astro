---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const resetExample = `*,
*::before,
*::after
  box-sizing: border-box
  margin: 0
  padding: 0

html
  -webkit-font-smoothing: antialiased
  scroll-behavior: smooth

img, video, svg
  display: block
  max-width: 100%

input, button, textarea, select
  font: inherit`;

const fontsExample = `@font-face
  font-family: 'Inter'
  src: url('/fonts/inter.woff2') format('woff2')
  font-weight: 100 900
  font-display: swap

body
  font-family: 'Inter', -apple-system, sans-serif
  font-size: 16px
  line-height: 1.6`;

const themesExample = `:root
  --color-bg:         #0F172A
  --color-card:       #111827
  --color-border:     #1F2937
  --color-text:       #F8FAFC
  --color-text-muted: #94A3B8

// Optional dark/light variants
[data-theme="light"]
  --color-bg:         #F8FAFC
  --color-text:       #0F172A`;
---

<DocsLayout
  title="Base"
  description="Global styles applied once across the entire application."
>
  <header>
    <h1 class="gradient-text">Base</h1>
    <p>
      Resets, fonts, and themes — applied once across the entire application.
    </p>
  </header>

  <section class="docs-section">
    <h2>Purpose</h2>
    <p>
      The <code>base/</code> directory contains foundational styles loaded once:
      resets, fonts, and theme variables. These are not reusable components —
      they define the technical baseline everything else builds on.
    </p>
  </section>

  <section class="docs-section">
    <h2>_reset.sass</h2>
    <p>
      Normalizes browser defaults so you start from a consistent baseline.
      Keep it minimal — only reset what you actually override.
    </p>
    <CodeBlock code={resetExample} label="base/_reset.sass" />
  </section>

  <section class="docs-section">
    <h2>_fonts.sass</h2>
    <p>
      Declares <code>@font-face</code> rules, sets the base <code>font-family</code>
      on <code>body</code>, and defines base typography scale.
    </p>
    <CodeBlock code={fontsExample} label="base/_fonts.sass" />
  </section>

  <section class="docs-section">
    <h2>_themes.sass</h2>
    <p>
      Defines CSS custom properties for your design tokens.
      Using CSS variables here (rather than Sass variables) makes
      runtime theming possible without recompiling.
    </p>
    <CodeBlock code={themesExample} label="base/_themes.sass" />
  </section>
</DocsLayout>
