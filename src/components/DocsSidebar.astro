---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const nav = [
  {
    group: 'Getting Started',
    links: [
      { label: 'Introduction',           href: '/docs' },
      { label: 'File Structure',         href: '/docs/file-structure' },
      { label: 'Naming Conventions',     href: '/docs/naming-conventions' },
      { label: 'Working with AI', href: '/docs/ai' },
    ],
  },
  {
    group: 'Reference',
    links: [
      { label: 'Utilities',   href: '/docs/utilities' },
      { label: 'Base',        href: '/docs/base' },
      { label: 'Components',  href: '/docs/components' },
      { label: 'Views',       href: '/docs/views' },
      { label: 'Helpers',     href: '/docs/helpers' },
    ],
  },
];

function isActive(href: string) {
  if (href === '/docs') return currentPath === '/docs' || currentPath === '';
  return currentPath === href;
}
---

<nav class="docs-nav" aria-label="Documentation navigation">
  {nav.map(section => (
    <div class="group">
      <div class="group-label">{section.group}</div>
      <ul>
        {section.links.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
