---
interface Props {
  code: string;
  label?: string;
}
const { code, label } = Astro.props;
---

<div class="code-block">
  {label && (
    <div class="header">
      <span class="label">{label}</span>
    </div>
  )}
  <div class="body">
    <pre><code set:text={code}></code></pre>
  </div>
</div>
